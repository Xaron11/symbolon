root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,toml}]
indent_size = 4

# shfmt and bash-language-server read these.
[*.sh]
indent_size = 4
switch_case_indent = true

[crates/symbolon-app/ui/**]
indent_style = tab

[{LICENSE-*,*.lock}]
indent_style = unset
indent_size = unset
