{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Symbolon",
	"identifier": "dev.xaron11.symbolon",
	"build": {
		"devUrl": "http://localhost:5173",
		"frontendDist": "ui/build",
		"beforeDevCommand": { "script": "pnpm dev", "cwd": "ui" },
		"beforeBuildCommand": { "script": "pnpm build", "cwd": "ui" }
	},
	"app": {
		"windows": [{ "label": "main", "title": "Symbolon", "width": 1200, "height": 800 }],
		"security": {
			"csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
