{
	"name": "symbolon-ui",
	"version": "0.8.0",
	"private": true,
	"license": "(MIT OR Apache-2.0)",
	"type": "module",
	"packageManager": "pnpm@12.9.0",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "pnpm tokens && vite dev",
		"build": "pnpm tokens && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm tokens && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "pnpm tokens && prettier --check . && eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ --max-warnings 0 . && stylelint --max-warnings 0 'src/**/*.{css,svelte}'",
		"format": "prettier --write .",
		"license-check": "node scripts/check-licenses.ts",
		"tokens": "node scripts/build-tokens.ts",
		"keymap-doc": "node scripts/build-keymap-doc.ts",
		"test": "pnpm tokens && vitest run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.13",
		"@types/culori": "^4.0.1",
		"@types/node": "^24",
		"axe-core": "^4.14.1",
		"culori": "^4.0.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsdoc": "^65.5.3",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"postcss-html": "^2.0.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"style-dictionary": "^5.8.0",
		"stylelint": "^18.1.0",
		"stylelint-declaration-strict-value": "^1.13.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@lucide/svelte": "^1.81.0",
		"@tauri-apps/api": "^2.12.5",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"bits-ui": "^2.22.0",
		"chart.js": "^4.6.2"
	},
	"engines": {
		"node": ">=24"
	}
}
